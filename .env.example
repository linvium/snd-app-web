# Playwright E2E (optional): service role is only for `npm run test:e2e:seed`
# SUPABASE_SERVICE_ROLE_KEY=

# Didit KYC secrets live on Supabase Edge Functions, not Vercel:
# DIDIT_API_KEY, DIDIT_WORKFLOW_ID, DIDIT_WEBHOOK_SECRET, DIDIT_ENVIRONMENT, APP_URL

# Payment and email secrets live there too - see supabase/functions/README.md:
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, PAYMENT_PROVIDER,
# RESEND_API_KEY, EMAIL_FROM, APP_URL
#
# Sandbox only: shows a "mark as paid" button on /pay/[token], and must be set
# on the edge function as PAYMENT_MANUAL_CONFIRM=true as well. Leave it unset
# anywhere Stripe keys are configured.
# NEXT_PUBLIC_PAYMENT_MANUAL_CONFIRM=
